{
  "manifest_version": 3,
  "name": "__MSG_ext_name__",
  "version": "2.7.0",
  "description": "__MSG_ext_description__",
  "default_locale": "en",
  "minimum_chrome_version": "141",
  "permissions": [
    "bookmarks",
    "sidePanel",
    "favicon",
    "storage",
    "tabs",
    "tabGroups"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "__MSG_ext_name__",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "commands": {
    "open-bookmarks": {
      "suggested_key": {
        "default": "Alt+B"
      },
      "description": "__MSG_command_toggle__"
    }
  }
}
